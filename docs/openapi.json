  "components": {
    "schemas": {
      "Body_upload_fs_upload_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_upload_fs_upload_post"
      },
      "CategoryIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Name"
          },
          "color": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CategoryIn"
      },
      "FeedbackIn": {
        "properties": {
          "rel_path": {
            "type": "string",
            "title": "Rel Path"
          },
          "correct_category_id": {
            "type": "integer",
            "title": "Correct Category Id"
          }
        },
        "type": "object",
        "required": [
          "rel_path",
          "correct_category_id"
        ],
        "title": "FeedbackIn"
      },
      "FolderIn": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "default": ""
          }
        },
        "type": "object",
        "title": "FolderIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LabelIn": {
        "properties": {
          "rel_path": {
            "type": "string",
            "title": "Rel Path"
          },
          "category_id": {
            "type": "integer",
            "title": "Category Id"
          }
        },
        "type": "object",
        "required": [
          "rel_path",
          "category_id"
        ],
        "title": "LabelIn"
      },
      "PredictIn": {
        "properties": {
          "rel_path": {
            "type": "string",
            "title": "Rel Path"
          }
        },
        "type": "object",
        "required": [
          "rel_path"
        ],
        "title": "PredictIn"
      },
      "SynthIn": {
        "properties": {
          "per_class": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Per Class",
            "default": 20
          },
          "noise": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Noise",
            "default": 0.1
          }
        },
        "type": "object",
        "title": "SynthIn"
      },
      "TrainIn": {
        "properties": {
          "algos": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Algos"
          },
          "test_size": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Size"
          }
        },
        "type": "object",
        "title": "TrainIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}