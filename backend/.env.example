# Folder with YOUR documents (pdf, docx, txt, md). Windows example: C:/Users/you/Documents/docs
DOCS_ROOT=./sample_docs
# Where the SQLite DB and trained models live (git-ignored)
DATA_DIR=./data
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,md
# Fraction of labeled docs held out for testing (0.05 - 0.5)
TEST_SIZE=0.2
RANDOM_SEED=42
# Training is refused if any labeled category has fewer docs than this
MIN_DOCS_PER_CLASS=5
# TF-IDF vocabulary size and n-gram range (min,max words)
MAX_FEATURES=20000
NGRAM_RANGE=1,2
# Predictions below this confidence are shown as "Uncertain"
UNCERTAIN_BELOW=0.5
CORS_ORIGINS=http://localhost:5173
